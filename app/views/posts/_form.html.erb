<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div id="error_explanation" style="color: red;">
      <h3><%= pluralize(post.errors.count, "個のエラー") %>があります:</h3>
      <ul>
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title, style: "width: 100%; margin-bottom: 10px;" %>
  </div>

  <div>
    <%= form.label :content, "本文" %><br>
    <%= form.text_area :content, rows: 10, style: "width: 100%; margin-bottom: 10px;" %>
  </div>

  <div>
    <%= form.submit "投稿", style: "background-color: #007bff; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;" %>
  </div>
<% end %>
