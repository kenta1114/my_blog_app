<p style="color: green"><%= notice %></p>

<div style="border: 1px solid #ddd; padding: 20px; border-radius: 5px; margin-bottom: 20px;">
  <%= render @post %>
  <small style="color: #666; display: block; margin-top: 15px;">
    投稿日時: <%= @post.created_at.strftime("%Y年%m月%d日 %H:%M") %>
    <% if @post.updated_at != @post.created_at %>
      | 最終更新: <%= @post.updated_at.strftime("%Y年%m月%d日 %H:%M") %>
    <% end %>
  </small>
</div>

<div>
  <%= link_to "編集", edit_post_path(@post), 
      style: "background-color: #ffc107; color: black; padding: 8px 15px; text-decoration: none; border-radius: 4px; margin-right: 10px;" %>
  <%= link_to "一覧に戻る", posts_path, 
      style: "background-color: #6c757d; color: white; padding: 8px 15px; text-decoration: none; border-radius: 4px; margin-right: 10px;" %>
  <%= button_to "削除", @post, method: :delete, 
      confirm: "本当に削除しますか？", 
      style: "background-color: #dc3545; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer;" %>
</div>
